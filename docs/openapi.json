  "info": {
    "description": "API for reporting, searching, and claiming lost or found items on campus.",
    "title": "Campus Lost & Found API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/items": {
      "get": {
        "description": "Browse public found items with optional search and filters.",
        "operationId": "list_items_items_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Category"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "location",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Location"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ItemStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "count": 1,
                  "items": [
                    {
                      "category": "bottle",
                      "created_at": "2026-11-08T14:58:43.316512Z",
                      "date_found": "2026-10-01",
                      "description": "Metal bottle with a sticker on the side.",
                      "id": 12,
                      "location_found": "Building A, lecture hall 2",
                      "status": "open",
                      "title": "Blue water bottle"
                    }
                  ],
                  "limit": 20,
                  "offset": 0
                },
                "schema": {
                  "$ref": "#/components/schemas/ItemListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "query",
                        "limit"
                      ],
                      "msg": "Input should be less than or equal to 100",
                      "type": "less_than_equal"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "List found items",
        "tags": [
          "items"
        ]
      },
      "post": {
        "description": "Create an open found-item record without exposing finder contact.",
        "operationId": "create_item_items_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "category": "bottle",
                  "created_at": "2026-11-08T14:58:43.316512Z",
                  "date_found": "2026-10-01",
                  "description": "Metal bottle with a sticker on the side.",
                  "id": 12,
                  "location_found": "Building A, lecture hall 2",
                  "status": "open",
                  "title": "Blue water bottle"
                },
                "schema": {
                  "$ref": "#/components/schemas/ItemPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "category"
                      ],
                      "msg": "Input should be 'bottle', 'keys', 'clothing', 'electronics', 'id_card', 'bag' or 'other'",
                      "type": "enum"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Report a found item",
        "tags": [
          "items"
        ]
      }
    },
    "/items/{item_id}": {
      "get": {
        "description": "Return public item details and the number of claims.",
        "operationId": "get_item_items__item_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Item Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "category": "bottle",
                  "claim_count": 1,
                  "created_at": "2026-11-08T14:58:43.316512Z",
                  "date_found": "2026-10-01",
                  "description": "Metal bottle with a sticker on the side.",
                  "id": 12,
                  "location_found": "Building A, lecture hall 2",
                  "status": "open",
                  "title": "Blue water bottle"
                },
                "schema": {
                  "$ref": "#/components/schemas/ItemDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Item 999 not found"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Item not found"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "path",
                        "item_id"
                      ],
                      "msg": "Input should be greater than or equal to 1",
                      "type": "greater_than_equal"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Get one found item",
        "tags": [
          "items"
        ]
      },
      "patch": {
        "description": "Reopen or mark a claimed item as returned.",
        "operationId": "update_item_items__item_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Item Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "category": "bottle",
                  "created_at": "2026-11-08T14:58:43.316512Z",
                  "date_found": "2026-10-01",
                  "description": "Metal bottle with a sticker on the side.",
                  "id": 12,
                  "location_found": "Building A, lecture hall 2",
                  "status": "open",
                  "title": "Blue water bottle"
                },
                "schema": {
                  "$ref": "#/components/schemas/ItemPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Item 999 not found"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Item not found"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Cannot change item 12 from open to claimed."
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid status transition"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "status"
                      ],
                      "msg": "Field required",
                      "type": "missing"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Update item status",
        "tags": [
          "items"
        ]
      }
    },
    "/items/{item_id}/claims": {
      "get": {
        "description": "Return finder-only claim details, including proof. This endpoint currently has no authentication.",
        "operationId": "list_claims_items__item_id__claims_get",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Item Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [
                  {
                    "claimant_contact": "alex@example.com",
                    "claimant_name": "Alex Example",
                    "created_at": "2026-11-08T15:01:49.191598Z",
                    "id": 1,
                    "item_id": 12,
                    "proof_description": "The sticker shows a mountain and there is a dent near the lid.",
                    "status": "pending"
                  }
                ],
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClaimFinder"
                  },
                  "title": "Response List Claims Items  Item Id  Claims Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Item 999 not found"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Item not found"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "path",
                        "item_id"
                      ],
                      "msg": "Input should be greater than or equal to 1",
                      "type": "greater_than_equal"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Review item claims",
        "tags": [
          "claims"
        ]
      },
      "post": {
        "description": "Create a pending claim while the item remains open.",
        "operationId": "create_claim_items__item_id__claims_post",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Item Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "claimant_contact": "alex@example.com",
                  "claimant_name": "Alex Example",
                  "created_at": "2026-11-08T15:01:49.191598Z",
                  "id": 1,
                  "item_id": 12,
